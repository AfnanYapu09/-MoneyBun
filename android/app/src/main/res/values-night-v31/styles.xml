<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ dark-mode launch: same terracotta brand splash as light
         mode (the Dart splash is terracotta in both themes). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_cream</item>
        <!-- Android 12+ shows the launcher icon on the system splash by default;
             a transparent "icon" hides it so the Dart Bun jump is the first thing seen. -->
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
